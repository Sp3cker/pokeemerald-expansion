{
  "compilerOptions": {
    "target": "ES2021",
  "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
  "strict": true,
  "types": ["node"]
  },
  "include": ["src/**/*"]
}
